rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Property photos & video walkthroughs: readable by public storefront, writable by authenticated agents
    match /properties/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /walkthroughs/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Buyer reservation receipts: readable by authenticated agents, writable by buyers/agents (max 10MB)
    match /receipts/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.resource.size < 10 * 1024 * 1024;
    }
  }
}

