rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Agent avatars & credibility seals: public read, write with max 5MB
    match /avatars/{allPaths=**} {
      allow read: if true;
      allow write: if request.resource.size < 5 * 1024 * 1024;
    }

    match /badges/{allPaths=**} {
      allow read: if true;
      allow write: if request.resource.size < 5 * 1024 * 1024;
    }

    // Property photos & video walkthroughs: public read, write with max 25MB
    match /properties/{allPaths=**} {
      allow read: if true;
      allow write: if request.resource.size < 25 * 1024 * 1024;
    }

    match /walkthroughs/{allPaths=**} {
      allow read: if true;
      allow write: if request.resource.size < 100 * 1024 * 1024;
    }

    // Buyer reservation receipts: readable by agents, writable by buyers/agents (max 10MB)
    match /receipts/{allPaths=**} {
      allow read: if true;
      allow write: if request.resource.size < 10 * 1024 * 1024;
    }

    // KYC compliance documents: readable by agents, writable by buyers/agents (max 15MB)
    match /kyc/{allPaths=**} {
      allow read: if true;
      allow write: if request.resource.size < 15 * 1024 * 1024;
    }

    // Quotation PDF proposals: readable by anyone with the token link
    match /quotations/{allPaths=**} {
      allow read: if true;
      allow write: if request.resource.size < 10 * 1024 * 1024;
    }
  }
}
